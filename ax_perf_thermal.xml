  Performance/Thermal configuration

  Device: Xiaomi Pad 7 (uke)
  SoC: Qualcomm Snapdragon 7+ Gen 3 (SM7675 / SM8635, "cliffs")

  CPU, read from the device (scaling_available_frequencies):
  +==============================================================================================================+
  | Cores | Policy  | Cluster | OPP (MHz)                                                                         |
  |=======|=========|=========|===================================================================================|
  | 0-2   | policy0 | Little  | 364, 441, 595, 787, 902, 1017, 1113, 1228, 1344, 1478, 1593, 1708, 1843, 1900     |
  |=======|=========|=========|===================================================================================|
  | 3-6   | policy3 | Big     | 480, 633, 787, 940, 1056, 1190, 1286, 1401, 1497, 1593, 1708, 1824, 1920, 2073,   |
  |       |         |         | 2188, 2361, 2572, 2611                                                            |
  |=======|=========|=========|===================================================================================|
  | 7     | policy7 | Prime   | 480, 633, 787, 960, 1094, 1209, 1324, 1459, 1651, 1766, 1900, 2150, 2304, 2457,   |
  |       |         |         | 2668, 2803                                                                        |
  +==============================================================================================================+

  GPU:
  +============================================================+
  | Model      | OPP (MHz)                                     |
  |============================================================|
  | Adreno 732 | 255, 353, 500, 633, 684, 736, 835, 900, 950   |
  +============================================================+

  The CPU ladder takes one OPP step off one cluster per level (prime first, then big, then little), down to
  ~30% of the maximum on big and prime and the minimum on little. Level 1 is no limit.
-->
<perf-config>
    <atmc>
        <!-- CPU Frequency Ladder -->
        <cpu_levels>
            <level id="1" little="0,1900" big="0,2611" prime="0,2803"/>
            <level id="2" little="0,1900" big="0,2611" prime="0,2668"/>
            <level id="3" little="0,1900" big="0,2361" prime="0,2668"/>
            <level id="4" little="0,1708" big="0,2361" prime="0,2668"/>
            <level id="5" little="0,1708" big="0,2361" prime="0,2304"/>
            <level id="6" little="0,1708" big="0,2188" prime="0,2304"/>
            <level id="7" little="0,1593" big="0,2188" prime="0,2304"/>
            <level id="8" little="0,1593" big="0,2188" prime="0,2150"/>
            <level id="9" little="0,1593" big="0,1920" prime="0,2150"/>
            <level id="10" little="0,1344" big="0,1920" prime="0,2150"/>
            <level id="11" little="0,1344" big="0,1920" prime="0,1766"/>
            <level id="12" little="0,1344" big="0,1708" prime="0,1766"/>
            <level id="13" little="0,1228" big="0,1708" prime="0,1766"/>
            <level id="14" little="0,1228" big="0,1708" prime="0,1651"/>
            <level id="15" little="0,1228" big="0,1593" prime="0,1651"/>
            <level id="16" little="0,1017" big="0,1593" prime="0,1651"/>
            <level id="17" little="0,1017" big="0,1593" prime="0,1324"/>
            <level id="18" little="0,1017" big="0,1401" prime="0,1324"/>
            <level id="19" little="0,787" big="0,1401" prime="0,1324"/>
            <level id="20" little="0,787" big="0,1401" prime="0,1209"/>
            <level id="21" little="0,787" big="0,1190" prime="0,1209"/>
            <level id="22" little="0,595" big="0,1190" prime="0,1209"/>
            <level id="23" little="0,595" big="0,1190" prime="0,960"/>
            <level id="24" little="0,595" big="0,1056" prime="0,960"/>
            <level id="25" little="0,364" big="0,1056" prime="0,960"/>
            <level id="26" little="0,364" big="0,1056" prime="0,787"/>
            <level id="27" little="0,364" big="0,787" prime="0,787"/>
        </cpu_levels>

        <!-- GPU Frequency Ladder -->
        <gpu_levels>
            <level id="1" min="950" max="950"/>
            <level id="2" min="950" max="950"/>
            <level id="3" min="900" max="900"/>
            <level id="4" min="835" max="835"/>
            <level id="5" min="835" max="835"/>
            <level id="6" min="736" max="736"/>
            <level id="7" min="684" max="684"/>
            <level id="8" min="633" max="633"/>
            <level id="9" min="500" max="500"/>
            <level id="10" min="353" max="353"/>
            <level id="11" min="255" max="255"/>
        </gpu_levels>

        <!-- Base Profiles / Scenes -->
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="11"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="12"/>
                    <action unit="bg_killer" status="4"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="19"/>
                </level>
            </scene>

            <scene name="game">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="17"/>
                </level>
                <level id="11">
                    <action unit="gpu" status="8"/>
                    <action unit="cpu" status="20"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="10"/>
                </level>
            </scene>

            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="20"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="22"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="24"/>
                </level>
            </scene>

            <scene name="axcamera_photo_preview">
                <level id="9">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="21"/>
                </level>
            </scene>
        </scenes>

        <!-- Application Specific Thermal & Performance Overrides -->
        <apps>
            <!-- Benchmarks: Allow higher sustained performance before aggressive throttling -->
            <app pkgs="com.antutu.ABenchMark,com.andromeda.androbench2,com.primatelabs.geekbench5,com.primatelabs.geekbench6,net.kishonti.gfxbench.v50000.corporate">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="24"/>
                </level>
            </app>

            <app pkgs="com.futuremark.dmandroid.application">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="8"/>
                </level>
                <level id="14">
                    <action unit="gpu" status="10"/>
                </level>
            </app>

            <!-- Social / Messaging / Video Calls: Early throttling to prevent chassis heating -->
            <app pkgs="com.instagram.android,com.facebook.katana,com.whatsapp,com.snapchat.android,us.zoom.videomeetings,com.microsoft.teams">
                <level id="4">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="6">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="19"/>
                </level>
            </app>

            <!-- Navigation: Smoother step-down curve for sustained GPS/Screen sessions -->
            <app pkgs="com.google.android.apps.maps,com.waze">
                <level id="7">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="22"/>
                </level>
            </app>

            <!-- Heavy Games: Tuned for sustained thermal stability over burst spikes -->
            <app pkgs="com.tencent.tmgp.pubgmhd,com.epicgames.fortnite,com.miHoYo.GenshinImpact,com.miHoYo.hkrpg,com.mojang.minecraftpe,com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.pubg.imobile,com.activision.callofduty.shooter,com.dts.freefireth,com.dts.freefiremax">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="18"/>
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>
